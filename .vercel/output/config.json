{
  "version": 3,
  "routes": [
    {
      "src": "^(?:/(.*))$",
      "headers": {
        "Location": "https://www.dsmar.com/$1"
      },
      "status": 308,
      "has": [
        {
          "type": "host",
          "value": "dsmar.com"
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^(?:/(.*))$",
      "dest": "/index.html",
      "check": true
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    }
  ],
  "framework": {
    "slug": "vite",
    "version": "7.3.6"
  },
  "crons": []
}
